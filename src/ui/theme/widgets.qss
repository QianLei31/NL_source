QWidget[role="page-control-panel"] QLabel[role="status-line"][state="warn"],
QFrame[role="page-control-panel"] QLabel[role="status-line"][state="warn"],
QWidget#spiControlPanel QLabel[role="status-line"][state="warn"] {
