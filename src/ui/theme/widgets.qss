QWidget[role="page-control-panel"] QLabel[role="status-line"][state="ok"],
QFrame[role="page-control-panel"] QLabel[role="status-line"][state="ok"],
QWidget#spiControlPanel QLabel[role="status-line"][state="ok"] {
