    padding: 0 3px;
    color: @violet;
    font-size: 11px;
}
QScrollArea#analyzerControlPanel QLabel,
QWidget[role="page-control-panel"] QLabel,
QFrame[role="page-control-panel"] QLabel,
QWidget#spiControlPanel QLabel {
    color: @text-secondary;
    background: transparent;
    font-size: 11px;
}
QScrollArea#analyzerControlPanel QLineEdit,
QScrollArea#analyzerControlPanel QSpinBox,
QScrollArea#analyzerControlPanel QDoubleSpinBox,
QScrollArea#analyzerControlPanel QComboBox,
QWidget[role="page-control-panel"] QLineEdit,
QWidget[role="page-control-panel"] QSpinBox,
QWidget[role="page-control-panel"] QDoubleSpinBox,
QWidget[role="page-control-panel"] QComboBox,
QFrame[role="page-control-panel"] QLineEdit,
QFrame[role="page-control-panel"] QSpinBox,
QFrame[role="page-control-panel"] QDoubleSpinBox,
QFrame[role="page-control-panel"] QComboBox,
QWidget#spiControlPanel QLineEdit,
QWidget#spiControlPanel QSpinBox,
QWidget#spiControlPanel QDoubleSpinBox,
QWidget#spiControlPanel QComboBox {
    background: @input-bg;
    color: @text-primary;
    border: 1px solid @card-border;
    border-radius: 3px;
    min-height: 22px;
    padding: 2px 6px;
    font-family: "Consolas", "Microsoft YaHei UI";
}
QWidget[role="page-control-panel"] QPlainTextEdit,
QWidget[role="page-control-panel"] QListWidget,
QFrame[role="page-control-panel"] QPlainTextEdit,
QFrame[role="page-control-panel"] QListWidget,
QWidget#spiControlPanel QPlainTextEdit,
QWidget#spiControlPanel QListWidget {
    background: @input-bg;
    color: @text-primary;
    border: 1px solid @card-border;
    border-radius: 3px;
    padding: 3px 6px;
    font-family: "Consolas", "Microsoft YaHei UI";
    font-size: 11px;
}
QScrollArea#analyzerControlPanel QLineEdit:focus,
QScrollArea#analyzerControlPanel QSpinBox:focus,
QScrollArea#analyzerControlPanel QDoubleSpinBox:focus,
QScrollArea#analyzerControlPanel QComboBox:focus,
QWidget[role="page-control-panel"] QLineEdit:focus,
QWidget[role="page-control-panel"] QSpinBox:focus,
QWidget[role="page-control-panel"] QDoubleSpinBox:focus,
QWidget[role="page-control-panel"] QComboBox:focus,
QFrame[role="page-control-panel"] QLineEdit:focus,
QFrame[role="page-control-panel"] QSpinBox:focus,
QFrame[role="page-control-panel"] QDoubleSpinBox:focus,
QFrame[role="page-control-panel"] QComboBox:focus,
QWidget#spiControlPanel QLineEdit:focus,
QWidget#spiControlPanel QSpinBox:focus,
QWidget#spiControlPanel QDoubleSpinBox:focus,
QWidget#spiControlPanel QComboBox:focus {
    border-color: @primary;
}
QScrollArea#analyzerControlPanel QPushButton,
QWidget[role="page-control-panel"] QPushButton,
QFrame[role="page-control-panel"] QPushButton,
QWidget#spiControlPanel QPushButton {
    background: @surface-control;
    color: @text-primary;
    border: 1px solid @card-border;
    border-radius: 3px;
    min-height: 22px;
    padding: 2px 7px;
    font-weight: 600;
}
QScrollArea#analyzerControlPanel QPushButton:hover,
QWidget[role="page-control-panel"] QPushButton:hover,
QFrame[role="page-control-panel"] QPushButton:hover,
QWidget#spiControlPanel QPushButton:hover {
    background: @tab-hover-bg;
    border-color: @primary;
    color: @text-primary;
}
QScrollArea#analyzerControlPanel QPushButton[variant="primary"],
QWidget[role="page-control-panel"] QPushButton[variant="primary"],
QFrame[role="page-control-panel"] QPushButton[variant="primary"],
QWidget#spiControlPanel QPushButton[variant="primary"] {
    background: @primary;
    color: @text-on-primary;
    border-color: @primary;
    font-weight: 700;
}
QScrollArea#analyzerControlPanel QPushButton[variant="primary"]:hover,
QWidget[role="page-control-panel"] QPushButton[variant="primary"]:hover,
QFrame[role="page-control-panel"] QPushButton[variant="primary"]:hover,
QWidget#spiControlPanel QPushButton[variant="primary"]:hover {
    background: @primary-hover;
    border-color: @primary-hover;
    color: @text-on-primary;
}
QScrollArea#analyzerControlPanel QPushButton[variant="secondary"],
QWidget[role="page-control-panel"] QPushButton[variant="secondary"],
QFrame[role="page-control-panel"] QPushButton[variant="secondary"],
QWidget#spiControlPanel QPushButton[variant="secondary"] {
    background: @card-bg;
    color: @text-secondary;
    border-color: @card-border;
}
QScrollArea#analyzerControlPanel QPushButton[variant="secondary"]:hover,
QWidget[role="page-control-panel"] QPushButton[variant="secondary"]:hover,
QFrame[role="page-control-panel"] QPushButton[variant="secondary"]:hover,
QWidget#spiControlPanel QPushButton[variant="secondary"]:hover {
    background: @card-bg-elevated;
    color: @text-primary;
    border-color: @card-border-hi;
}
QScrollArea#analyzerControlPanel QPushButton[variant="danger"],
QWidget[role="page-control-panel"] QPushButton[variant="danger"],
QFrame[role="page-control-panel"] QPushButton[variant="danger"],
QWidget#spiControlPanel QPushButton[variant="danger"] {
    background: transparent;
    color: @error;
    border-color: @error;
}
QScrollArea#analyzerControlPanel QPushButton[variant="danger"]:hover,
QWidget[role="page-control-panel"] QPushButton[variant="danger"]:hover,
QFrame[role="page-control-panel"] QPushButton[variant="danger"]:hover,
QWidget#spiControlPanel QPushButton[variant="danger"]:hover {
    background: @error-soft-bg;
    color: @error;
}
QScrollArea#analyzerControlPanel QCheckBox,
QWidget[role="page-control-panel"] QCheckBox,
QFrame[role="page-control-panel"] QCheckBox,
QWidget#spiControlPanel QCheckBox {
    spacing: 5px;
    color: @text-primary;
    background: transparent;
}
QScrollArea#analyzerControlPanel QCheckBox::indicator,
QWidget[role="page-control-panel"] QCheckBox::indicator,
QFrame[role="page-control-panel"] QCheckBox::indicator,
QWidget#spiControlPanel QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid @card-border;
    border-radius: 3px;
    background: @input-bg;
}
QScrollArea#analyzerControlPanel QCheckBox::indicator:checked,
QWidget[role="page-control-panel"] QCheckBox::indicator:checked,
QFrame[role="page-control-panel"] QCheckBox::indicator:checked,
QWidget#spiControlPanel QCheckBox::indicator:checked {
    background: @primary;
    border-color: @primary;
}

QScrollArea#analyzerControlPanel QLabel[role="status-line"],
QWidget[role="page-control-panel"] QLabel[role="status-line"],
QFrame[role="page-control-panel"] QLabel[role="status-line"],
QWidget#spiControlPanel QLabel[role="status-line"] {
    color: @info;
    background: @surface-sunken;
    border: 1px solid @card-border;
    border-radius: @radius-sm;
    padding: 5px 7px;
    font-size: 11px;
}
QScrollArea#analyzerControlPanel QLabel[role="status-line"][state="info"],
QWidget[role="page-control-panel"] QLabel[role="status-line"][state="info"],
QFrame[role="page-control-panel"] QLabel[role="status-line"][state="info"],
QWidget#spiControlPanel QLabel[role="status-line"][state="info"] {
