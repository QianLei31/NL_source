}
QScrollArea#analyzerControlPanel QLabel[role="status-line"][state="error"],
QWidget[role="page-control-panel"] QLabel[role="status-line"][state="error"],
QFrame[role="page-control-panel"] QLabel[role="status-line"][state="error"],
QWidget#spiControlPanel QLabel[role="status-line"][state="error"] {
