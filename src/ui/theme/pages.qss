/* pages.qss — Page-level layout (Dark Precision Instrument) */

/* Banner */
QFrame[role="banner"] {
    background: @card-bg;
    border: 1px solid @card-border;
    border-radius: @radius-md;
    padding: 8px 16px;
    margin-bottom: @gap-md;
}
QFrame[role="banner"][severity="warning"] {
    border-color: @warning;
    background: rgba(210, 153, 34, 0.06);
}
QFrame[role="banner"][severity="error"] {
    border-color: @error;
    background: rgba(248, 81, 73, 0.06);
}

/* Page header */
QFrame[role="page-header"] {
    padding: 8px 0;
    margin-bottom: @gap-md;
}

/* Inspector panel */
QFrame[role="inspector"] {
    background: @card-bg;
    border: 1px solid @card-border;
    border-radius: @radius-lg;
    padding: 16px;
    min-width: 200px;
}
